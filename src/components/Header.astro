<header
  class="fixed top-0 left-0 right-0 flex items-center justify-between border-b border-primary dark:border-paper/20 bg-paper/90 backdrop-blur-sm dark:bg-background-dark/90 px-4 py-3 z-50 transition-transform duration-300"
  id="main-header"
>
  <div class="flex items-center gap-2">
    <span class="material-symbols-outlined text-2xl">castle</span>
    <h1 class="text-xl font-black uppercase tracking-tighter italic">
      astro-site
    </h1>
    <button
      class="bg-[#1b3d22] text-paper px-4 py-1.5 text-xs font-bold uppercase border border-[#1b3d22] dark:border-paper/40 ml-4"
      >[what is done]</button
    >
  </div>
  <a
    href="/login"
    class="bg-primary text-paper px-4 py-1.5 text-xs font-bold uppercase border border-primary dark:border-paper/40"
  >
    Enter
  </a>
</header>

<script>
  let lastScrollY = window.scrollY;
  const header = document.getElementById('main-header');
  window.addEventListener('scroll', () => {
    if (header) {
      if (window.scrollY > lastScrollY && window.scrollY > 100) {
        header.classList.add('hide-header');
      } else {
        header.classList.remove('hide-header');
      }
    }
    lastScrollY = window.scrollY;
  });
</script>
