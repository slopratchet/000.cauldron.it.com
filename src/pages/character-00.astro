---
const skills = [
  'Automatic weapons',
  'Dagger',
  'Dodge',
  'Parachuting',
  'Interrogation',
  'First Aid',
  'Hide',
  'Throwing weapons',
  'Climb',
  'Drive car',
  'Motor mechanics',
  'Piloting',
  'Handgun',
  'Radio communications',
  'Swimming',
  'Sneak',
  'Demolition',
  'Martial arts: commando',
  'Heavy weapons',
  'Survival',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dossier Profile</title>
    <style is:global>
      @import url('https://fonts.googleapis.com/css2?family=Archivo+Narrow:ital,wght@0,400..700;1,400..700&family=JetBrains+Mono:wght@400;700&display=swap');
      @import 'tailwindcss';

      @theme {
        --color-surface: #fcf9f8;
        --color-surfaceDim: #dcd9d9;
        --color-surfaceBright: #ffffff;
        --color-primary: #000000;
        --color-onSurface: #1a1a1a;
        --color-border: #000000;

        --font-sans: 'Archivo Narrow', ui-sans-serif, system-ui, sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;

        --border-width-thick: 4px;
        --border-width-medium: 2px;
      }

      body {
        background-color: var(--color-surface);
        color: var(--color-onSurface);
        font-family: var(--font-sans);
      }

      .brutalist-border {
        border: var(--border-width-thick) solid var(--color-border);
      }

      .brutalist-border-medium {
        border: var(--border-width-medium) solid var(--color-border);
      }

      .brutalist-border-bottom {
        border-bottom: var(--border-width-thick) solid var(--color-border);
      }

      .brutalist-border-right {
        border-right: var(--border-width-thick) solid var(--color-border);
      }

      .brutalist-border-top {
        border-top: var(--border-width-thick) solid var(--color-border);
      }

      .pattern-bg {
        background-image: radial-gradient(
          var(--color-surfaceDim) 1px,
          transparent 1px
        );
        background-size: 8px 8px;
      }

      .grid-bg {
        background-image:
          linear-gradient(var(--color-surfaceDim) 1px, transparent 1px),
          linear-gradient(90deg, var(--color-surfaceDim) 1px, transparent 1px);
        background-size: 20px 20px;
      }
    </style>
  </head>
  <body
    class="antialiased selection:bg-primary selection:text-surface font-sans"
  >
    <div
      class="min-h-screen flex flex-col md:flex-row antialiased selection:bg-primary selection:text-surface font-sans"
    >
      <aside
        class="w-full md:w-64 flex-shrink-0 brutalist-border-right border-b-4 md:border-b-0 border-border bg-surface flex flex-col z-20 sticky top-0 md:h-screen"
      >
        <div class="p-4 brutalist-border-bottom bg-primary text-surface">
          <h1
            class="text-2xl font-black uppercase tracking-widest font-mono leading-tight"
          >
            CHRONOS<br />SYS.
          </h1>
          <p class="text-xs mt-1 font-mono uppercase opacity-80">
            Terminal Interface v7.4
          </p>
        </div>
        <nav class="flex-1 overflow-y-auto p-4 space-y-2">
          <div class="mb-6">
            <h2
              class="text-xs font-bold uppercase tracking-widest text-primary mb-2 border-b-2 border-border pb-1"
            >
              Database
            </h2>
            <ul class="space-y-1">
              <li>
                <a
                  class="block px-2 py-1 hover:bg-primary hover:text-surface transition-colors font-mono text-sm border border-transparent hover:border-primary"
                  href="#">Personnel Files</a
                >
              </li>
              <li>
                <a
                  class="block px-2 py-1 bg-surfaceDim font-mono text-sm border-l-4 border-primary font-bold"
                  href="#">Active Profile</a
                >
              </li>
              <li>
                <a
                  class="block px-2 py-1 hover:bg-primary hover:text-surface transition-colors font-mono text-sm border border-transparent hover:border-primary"
                  href="#">Incident Reports</a
                >
              </li>
            </ul>
          </div>
        </nav>
        <div
          class="p-4 brutalist-border-top border-border bg-surfaceDim text-xs font-mono"
        >
          <p>STATUS: <span class="font-bold text-green-700">ONLINE</span></p>
          <p>UPTIME: 94:12:05</p>
          <p>USER: ADMIN_01</p>
        </div>
      </aside>

      <main class="flex-1 flex flex-col min-w-0 bg-surface">
        <header
          class="h-16 brutalist-border-bottom flex items-center justify-between px-6 bg-surfaceBright z-10 sticky top-0"
        >
          <div class="flex items-center space-x-4">
            <span class="font-mono font-bold text-xl uppercase"
              >Dossier: Veteran</span
            >
            <span
              class="hidden md:inline-block px-2 py-1 bg-primary text-surface text-xs font-mono uppercase"
              >Classified Level 4</span
            >
          </div>
          <div class="flex items-center space-x-4 font-mono text-sm">
            <span
              class="hidden sm:inline-block border-2 border-border px-2 py-1"
              >ID: VET-8492-X</span
            >
            <button
              class="bg-primary text-surface px-4 py-2 hover:bg-surface hover:text-primary brutalist-border-medium transition-colors font-bold uppercase"
              >Print File</button
            >
          </div>
        </header>

        <div class="p-4 md:p-8 flex-1 overflow-y-auto pattern-bg">
          <div class="max-w-6xl mx-auto space-y-8">
            {/* Header Block */}
            <div
              class="brutalist-border bg-surface p-6 sm:p-8 relative overflow-hidden"
            >
              <div
                class="absolute top-0 right-0 p-4 opacity-10 pointer-events-none"
              >
                <svg
                  fill="none"
                  height="120"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  width="120"
                >
                  <path
                    d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"
                  ></path>
                </svg>
              </div>
              <h1
                class="text-5xl sm:text-7xl font-black uppercase tracking-tighter mb-2 leading-none"
              >
                Veteran
              </h1>
              <h2
                class="text-xl sm:text-2xl font-mono uppercase tracking-widest text-primary border-t-4 border-border pt-2 inline-block"
              >
                Operator Profile
              </h2>
            </div>

            {/* Narrative Quote */}
            <div
              class="brutalist-border bg-primary text-surface p-6 sm:p-8 italic text-lg sm:text-xl font-medium border-l-[16px] border-l-surfaceDim"
            >
              "It usually happens when I get angry. Everything turns black, and
              then it's there—the roar of the bombers, the explosions, the pain,
              the dead faces. That's when I lose control and start beating
              everything and everyone around me."
            </div>

            {/* Grid Layout for Details */}
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
              {/* Column 1: Image & Basic Bio */}
              <div class="lg:col-span-1 space-y-8">
                {/* Technical Photograph */}
                <div
                  class="brutalist-border bg-surface p-2 pb-8 relative group"
                >
                  <div
                    class="absolute top-0 left-0 bg-primary text-surface px-2 py-1 text-xs font-mono z-10"
                  >
                    SUBJECT REF. IMG
                  </div>
                  <div
                    class="absolute bottom-2 right-2 font-mono text-[10px] opacity-50"
                  >
                    SCANNED: 1994-08-12
                  </div>
                  <img
                    alt="Illustration of a rugged veteran in camouflage pants, black t-shirt, and sunglasses"
                    class="w-full h-auto object-cover border-2 border-border filter sepia-[.2] contrast-125"
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuAj9iK390ZqFKdqHlWpoFJT3ku4FgPRKp0CEHkUOgsc70iPFFN10B2Y4uzCKw-q5fKEtSW7DEegbE3IPEWgpJI10pRHQUQkroCZZRmdOmDi8fhE8bx6QLJlCAB7CiSxBs71sYWcQvJ43Aj8251qcgNGxUZiEPGCBLKo9_z3R8bsEXN8looyvFcvEvN48kwOZyxzC3xIpEyV963PmibDEyIkNEdn4I0b68fO9HEJYe8fFr-WYy3t1C9RGzPY3pRzf4cKJlM7wwf5GfYm"
                    referrerpolicy="no-referrer"
                  />
                </div>

                {/* Basic Info Box */}
                <div class="brutalist-border bg-surface p-6">
                  <h3
                    class="text-2xl font-bold uppercase mb-4 border-b-2 border-border pb-2"
                  >
                    Bio-Data
                  </h3>
                  <dl class="space-y-4 font-mono text-sm">
                    <div>
                      <dt class="font-bold uppercase text-xs opacity-70">
                        Profession
                      </dt>
                      <dd class="text-lg">
                        Unemployed, General Worker<br />(Ex-Soldier)
                      </dd>
                    </div>
                    <div>
                      <dt class="font-bold uppercase text-xs opacity-70">
                        Living Standard
                      </dt>
                      <dd class="text-lg">3-5</dd>
                    </div>
                    <div class="pt-4 border-t border-border border-dashed">
                      <p class="font-sans text-base">
                        You are an ex-soldier and somewhat uncomfortable with
                        civilian life. It's difficult to live without clear
                        rules and commanders who tell you what to do. It breeds
                        disorder. You probably fought in some small, dirty war
                        in Africa, Southeast Asia or Latin America. Perhaps you
                        were in the French Foreign Legion, the US Army, the
                        Soviet Red Army, or a mercenary outfit.
                      </p>
                    </div>
                  </dl>
                </div>
              </div>

              {/* Column 2 & 3: Details & Matrices */}
              <div class="lg:col-span-2 space-y-8">
                {/* Special Status (Personality & Dark Secret) */}
                <div
                  class="brutalist-border bg-surface p-6 sm:p-8 grid-bg relative"
                >
                  <div
                    class="absolute top-2 right-2 px-2 py-1 bg-surface border-2 border-border text-xs font-mono font-bold"
                  >
                    PSYCH-EVAL REQUIRED
                  </div>
                  <h3
                    class="text-3xl font-black uppercase mb-6 bg-surface inline-block pr-4"
                  >
                    Psychological Profile
                  </h3>
                  <div class="space-y-6 bg-surface p-4 border-2 border-border">
                    <div>
                      <h4
                        class="text-xl font-bold uppercase border-b border-border pb-1 mb-2"
                      >
                        Personality
                      </h4>
                      <p class="font-sans text-lg">
                        Violent, sentimental, you have an intense love-hate
                        relationship with the military world. More or less
                        mentally damaged by war experiences.
                      </p>
                    </div>
                    <div>
                      <h4
                        class="text-xl font-bold uppercase border-b border-border pb-1 mb-2 text-red-900"
                      >
                        Dark Secret
                      </h4>
                      <ul
                        class="list-disc list-inside font-mono text-sm space-y-1 marker:text-primary"
                      >
                        <li>Family secret</li>
                        <li>Victim of crime</li>
                        <li>Guilty of crime</li>
                      </ul>
                    </div>
                  </div>
                </div>

                {/* Traits Ledger */}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                  {/* Disadvantages */}
                  <div class="brutalist-border bg-surface p-6 flex flex-col">
                    <h3
                      class="text-2xl font-black uppercase mb-4 bg-primary text-surface p-2 text-center"
                    >
                      Disadvantages
                    </h3>
                    <ul
                      class="font-mono text-sm space-y-2 flex-1 border-l-2 border-border pl-4"
                    >
                      <li
                        class="relative before:content-['>'] before:absolute before:-left-4 before:font-bold"
                      >
                        Depression
                      </li>
                      <li
                        class="relative before:content-['>'] before:absolute before:-left-4 before:font-bold"
                      >
                        Death wish
                      </li>
                      <li
                        class="relative before:content-['>'] before:absolute before:-left-4 before:font-bold"
                      >
                        Phobia (afraid of sudden noises or the dark)
                      </li>
                      <li
                        class="relative before:content-['>'] before:absolute before:-left-4 before:font-bold"
                      >
                        Mental constriction
                      </li>
                      <li
                        class="relative before:content-['>'] before:absolute before:-left-4 before:font-bold"
                      >
                        Paranoia
                      </li>
                      <li
                        class="relative before:content-['>'] before:absolute before:-left-4 before:font-bold"
                      >
                        Wanted (for desertion or crime)
                      </li>
                      <li
                        class="relative before:content-['>'] before:absolute before:-left-4 before:font-bold"
                      >
                        Touchy
                      </li>
                      <li
                        class="relative before:content-['>'] before:absolute before:-left-4 before:font-bold"
                      >
                        Habitual liar
                      </li>
                      <li
                        class="relative before:content-['>'] before:absolute before:-left-4 before:font-bold"
                      >
                        Drug addiction
                      </li>
                      <li
                        class="relative before:content-['>'] before:absolute before:-left-4 before:font-bold"
                      >
                        Mental compulsion
                      </li>
                    </ul>
                  </div>

                  {/* Advantages */}
                  <div class="brutalist-border bg-surface p-6 flex flex-col">
                    <h3
                      class="text-2xl font-black uppercase mb-4 bg-surfaceDim p-2 text-center border-b-4 border-border"
                    >
                      Advantages
                    </h3>
                    <ul
                      class="font-mono text-sm space-y-2 flex-1 border-l-2 border-border pl-4"
                    >
                      <li
                        class="relative before:content-['+'] before:absolute before:-left-4 before:font-bold"
                      >
                        Body awareness
                      </li>
                      <li
                        class="relative before:content-['+'] before:absolute before:-left-4 before:font-bold"
                      >
                        Pacifism
                      </li>
                      <li
                        class="relative before:content-['+'] before:absolute before:-left-4 before:font-bold"
                      >
                        Sixth sense
                      </li>
                      <li
                        class="relative before:content-['+'] before:absolute before:-left-4 before:font-bold"
                      >
                        Endure hunger/thirst/cold/heat/pain/torture
                      </li>
                    </ul>
                  </div>
                </div>

                {/* Skills Matrix */}
                <div class="brutalist-border bg-surface p-6 sm:p-8">
                  <div
                    class="flex items-center justify-between mb-6 border-b-4 border-border pb-2"
                  >
                    <h3 class="text-3xl font-black uppercase">
                      Tactical Skills Matrix
                    </h3>
                    <span
                      class="font-mono text-xs font-bold border-2 border-border p-1 hidden sm:inline-block"
                      >AUTHORIZED PERSONNEL ONLY</span
                    >
                  </div>
                  <div
                    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-x-8 gap-y-4 font-mono text-sm"
                  >
                    {
                      skills.map((skill) => (
                        <div class="flex items-center space-x-2 border-b border-border border-dashed pb-1">
                          <span class="w-2 h-2 bg-primary flex-shrink-0" />
                          <span>{skill}</span>
                        </div>
                      ))
                    }
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>
