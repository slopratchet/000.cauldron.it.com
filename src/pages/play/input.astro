---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  bodyClass="bg-[#cdc9c1] text-black font-label selection:bg-[#00fc40] selection:text-black min-h-screen"
>
  <style>
    .drop-cap::first-letter {
      float: left;
      font-size: 3.5rem;
      line-height: 0.8;
      padding-right: 0.5rem;
      margin-top: 0.2rem;
      font-weight: 400;
      color: #1a1a1a;
      font-family: 'EB Garamond', serif;
    }
    .grid-overlay {
      background-image: radial-gradient(circle, #222 1px, transparent 1px);
      background-size: 30px 30px;
    }
    .map-texture {
      background: radial-gradient(
        circle at center,
        transparent 0%,
        rgba(0, 0, 0, 0.4) 100%
      );
    }
    input:focus {
      outline: none;
      box-shadow: 0 0 15px rgba(0, 252, 64, 0.1);
    }
  </style>

  <!-- Desktop Wrapper -->
  <div
    class="relative mx-auto flex min-h-screen max-w-[1600px] flex-col overflow-hidden bg-black shadow-2xl"
  >
    <main
      class="grid flex-grow grid-cols-12 gap-0 overflow-hidden bg-black p-4 pb-0"
    >
      <!-- Left Column: Chronicles -->
      <section
        class="relative col-span-12 flex h-full flex-col border border-black/20 bg-white p-8 lg:col-span-3"
      >
        <div class="mb-8 flex items-center gap-2 border-b border-black/10 pb-4">
          <span class="material-symbols-outlined text-lg">menu_book</span>
          <h2
            class="font-label text-sm font-bold uppercase tracking-widest text-black"
          >
            Chronicles
          </h2>
        </div>
        <div
          class="drop-cap mb-12 font-serif text-[1.1rem] leading-relaxed text-zinc-800"
        >
          The celestial alignment has shifted. Scholars in the high tower of EB
          Garamond have noted a distinct crimson hue in the northern
          constellations, suggesting that the demonic idols, long thought to be
          dormant, are stirring once more.
          <br /><br />
          Adventurers returning from the Iron Keep report sightings of shadow-bound
          wraiths and stone sentinels manifesting where none stood before. The King's
          Decree remains in effect: all capable souls are to report to the nearest
          portal.
        </div>
        <!-- Operational Alert Box -->
        <div class="mb-8 border border-zinc-200 bg-zinc-100 p-5">
          <div
            class="mb-2 font-label text-[11px] font-bold uppercase tracking-widest text-black"
          >
            // OPERATIONAL ALERT //
          </div>
          <p class="font-serif text-[13px] leading-snug text-zinc-700">
            Reports from the frontier suggest a new vanguard has emerged. The
            ritual of Camp Candor MMORPG&gt;IT begins at the next lunar zenith.
          </p>
        </div>
        <div
          class="mt-auto font-serif text-[1.1rem] leading-relaxed text-zinc-800"
        >
          The shadows lengthen across the Aethelgard plains. Our scouts report a
          surge in aetheric activity near the Shadow Fen gates. Vigilance is
          required for all active units.
        </div>
      </section>

      <!-- Center Column: Tactical Command Dashboard -->
      <section class="col-span-12 flex flex-col px-4 lg:col-span-6">
        <!-- Map Viewport -->
        <div
          id="map-viewport"
          class="grid-overlay map-texture relative flex-grow overflow-hidden border border-white/20 bg-[#080808]"
        >
          <div
            id="surface00"
            class="absolute inset-0 h-full w-full pointer-events-none"
          >
          </div>
          <div
            class="absolute top-4 right-4 flex gap-4 font-mono text-[9px] text-zinc-500"
          >
            <span>COORDS: 42.12N / 15.88E</span>
            <span class="text-[#00fc40]/60">LIVE FEED ACTIVE</span>
          </div>
          <!-- Map Markers -->
          <div class="absolute top-[30%] left-[45%] flex flex-col items-center">
            <div class="relative flex h-8 w-8 items-center justify-center">
              <div
                class="absolute inset-0 animate-pulse rounded-full bg-[#00fc40]/20 blur-md"
              >
              </div>
              <span
                class="material-symbols-outlined text-2xl text-[#00fc40]"
                style="font-variation-settings: 'FILL' 1;">star</span
              >
            </div>
            <div class="mt-2 border border-white/10 bg-black px-2 py-0.5">
              <span
                class="text-[8px] font-bold uppercase tracking-widest text-white"
                >Aethelgard</span
              >
            </div>
          </div>
          <div
            class="absolute top-[25%] right-[20%] flex flex-col items-center"
          >
            <div class="relative flex h-12 w-12 flex-col items-center">
              <span
                class="material-symbols-outlined text-3xl text-[#f97316] opacity-80"
                >warning</span
              >
              <div class="mt-1 bg-[#f97316]/20 px-1">
                <span class="text-[7px] font-black uppercase text-[#f97316]"
                  >Anomaly</span
                >
              </div>
            </div>
          </div>
          <div
            class="absolute top-[50%] left-[55%] flex flex-col items-center opacity-40"
          >
            <span class="material-symbols-outlined text-xl text-red-600"
              >blur_on</span
            >
            <span class="mt-1 text-[8px] font-bold uppercase text-zinc-500"
              >Iron Keep</span
            >
          </div>
          <div
            class="absolute bottom-[25%] left-[38%] flex flex-col items-center"
          >
            <div class="relative flex h-10 w-10 items-center justify-center">
              <div class="absolute inset-0 rounded-full bg-red-600/30 blur-lg">
              </div>
              <span
                class="material-symbols-outlined text-3xl text-red-600"
                style="font-variation-settings: 'FILL' 1;">skull</span
              >
            </div>
            <div class="mt-1 bg-red-600 px-2 py-0.5">
              <span
                class="text-[8px] font-bold uppercase tracking-widest text-white"
                >Critical</span
              >
            </div>
          </div>
          <div
            class="absolute bottom-[20%] right-[35%] flex flex-col items-center"
          >
            <div class="relative flex h-8 w-8 items-center justify-center">
              <div class="absolute inset-0 bg-[#00fc40]/10 blur-sm"></div>
              <span
                class="material-symbols-outlined text-2xl text-[#00fc40]"
                style="font-variation-settings: 'FILL' 1;">pentagon</span
              >
            </div>
            <div class="mt-2 border border-white/10 bg-black px-2 py-0.5">
              <span
                class="text-[8px] font-bold uppercase tracking-widest text-white"
                >Elder Peak</span
              >
            </div>
          </div>
          <!-- Lower Left Status Readout -->
          <div
            class="absolute bottom-6 left-6 w-40 border border-white/10 bg-black/80 p-4 backdrop-blur-sm"
          >
            <div class="mb-2 text-[9px] font-bold uppercase text-[#00fc40]">
              Sensors: Active
            </div>
            <div class="mb-1.5 h-1.5 w-full bg-zinc-800">
              <div class="h-full w-[65%] bg-[#00fc40]"></div>
            </div>
            <div class="font-mono text-[7px] uppercase text-zinc-500">
              Lunar Alignment 65%
            </div>
          </div>
          <!-- Bottom Status Bar (Inner Map) -->
          <div
            class="absolute bottom-0 flex h-8 w-full items-center justify-between border-t border-white/5 bg-black/60 px-4"
          >
            <div class="flex items-center gap-2">
              <div class="h-2 w-2 bg-[#00fc40]"></div>
              <span
                class="text-[9px] font-bold uppercase tracking-widest text-zinc-400"
                >Global Network Secure</span
              >
            </div>
            <div class="font-mono text-[9px] tracking-widest text-[#00fc40]">
              PING: 42MS // LAT: 0.003
            </div>
          </div>
        </div>
      </section>

      <!-- Right Column: Sidebar -->
      <section class="col-span-12 flex flex-col gap-8 lg:col-span-3">
        <div class="flex flex-grow flex-col">
          <div class="mb-6 flex items-center gap-2">
            <span class="material-symbols-outlined text-sm text-white"
              >skull</span
            >
            <h3
              class="font-label text-[11px] font-bold uppercase tracking-[0.2em] text-white"
            >
              Urgent Apparitions
            </h3>
          </div>
          <div class="space-y-4">
            <div class="flex gap-4 border border-white/5 bg-zinc-900/50 p-4">
              <div
                class="flex h-16 w-16 shrink-0 items-center justify-center bg-white"
              >
                <img
                  alt="stalker icon"
                  class="h-12 w-12 grayscale contrast-125"
                  src="https://lh3.googleusercontent.com/aida-public/AK-a5mS_9hZf0V6S6C6Z6z6Z6z6Z6z6Z6z6Z6z6Z6z6Z6z6Z6z6Z6z6Z6z6Z6z6Z=s128"
                />
              </div>
              <div class="flex flex-col justify-center">
                <h4
                  class="text-[10px] font-bold uppercase leading-tight text-white"
                >
                  The Void-Stalker
                </h4>
                <div class="mb-2 text-[8px] italic text-zinc-500">
                  Shadow Fen, Lvl 42
                </div>
                <div
                  class="w-fit bg-red-900/30 px-1.5 py-0.5 text-[7px] font-black tracking-tighter text-red-500"
                >
                  THREAT: HIGH
                </div>
              </div>
            </div>
            <div class="flex gap-4 border border-white/5 bg-zinc-900/50 p-4">
              <div
                class="flex h-16 w-16 shrink-0 items-center justify-center bg-white"
              >
                <img
                  alt="guardian icon"
                  class="h-12 w-12 scale-x-[-1] grayscale contrast-125"
                  src="https://lh3.googleusercontent.com/aida-public/AK-a5mS_9hZf0V6S6C6Z6z6Z6z6Z6z6Z6z6Z6z6Z6z6Z6z6Z6z6Z6z6Z6z6Z6z6Z=s128"
                />
              </div>
              <div class="flex flex-col justify-center">
                <h4
                  class="text-[10px] font-bold uppercase leading-tight text-white"
                >
                  Relic Guardian
                </h4>
                <div class="mb-2 text-[8px] italic text-zinc-500">
                  Elder Peak, Lvl 55
                </div>
                <div
                  class="w-fit bg-red-600 px-1.5 py-0.5 text-[7px] font-black tracking-tighter text-white"
                >
                  THREAT: EXTREME
                </div>
              </div>
            </div>
          </div>
          <div class="mt-12">
            <div class="mb-6 flex items-center gap-2">
              <span class="material-symbols-outlined text-sm text-[#f97316]"
                >warning</span
              >
              <h3
                class="font-label text-[11px] font-bold uppercase tracking-[0.2em] text-white"
              >
                Anomalies
              </h3>
            </div>
            <div class="flex gap-4 border border-white/5 bg-zinc-900/50 p-4">
              <div
                class="flex h-16 w-16 shrink-0 items-center justify-center bg-white"
              >
                <img
                  alt="wraith icon"
                  class="h-12 w-12 grayscale invert"
                  src="https://lh3.googleusercontent.com/aida-public/AK-a5mS_9hZf0V6S6C6Z6z6Z6z6Z6z6Z6z6Z6z6Z6z6Z6z6Z6z6Z6z6Z6z6Z6z6Z=s128"
                />
              </div>
              <div class="flex flex-col justify-center">
                <h4
                  class="text-[10px] font-bold uppercase leading-tight text-white"
                >
                  Aether Wraith
                </h4>
                <div class="mb-2 text-[8px] italic text-zinc-500">
                  All Realms, Unranked
                </div>
                <div
                  class="w-fit bg-orange-900/30 px-1.5 py-0.5 text-[7px] font-black uppercase tracking-tighter text-orange-400"
                >
                  Stability: Unstable
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
    <!-- Command Input Area -->
    <div class="border-t border-white/10 bg-black px-12 py-10">
      <div class="group relative flex items-center">
        <input
          class="w-full border-2 border-[#00fc40] bg-zinc-900 px-8 py-10 font-label text-lg font-bold uppercase tracking-[0.4em] text-[#00fc40] shadow-[0_0_15px_rgba(0,252,64,0.2)] transition-all duration-300 placeholder:text-[#00fc40]/50 focus:bg-[#00fc40]/5 focus:text-[#00fc40] focus:shadow-[0_0_25px_rgba(0,252,64,0.4)] outline-none"
          placeholder="TYPE COMMAND..."
          type="text"
        />
        <button
          class="group/btn absolute right-4 top-1/2 flex -translate-y-1/2 cursor-pointer items-center gap-4 border border-orange-500/30 bg-orange-500/5 px-4 py-2 text-orange-500/70 transition-all duration-300 hover:bg-orange-500/20 hover:text-orange-500"
        >
          <span
            class="font-label hidden text-[10px] font-bold uppercase tracking-widest sm:block"
            >READY FOR UPLINK</span
          >
          <span
            class="material-symbols-outlined transition-transform text-sm group-hover/btn:scale-110"
            >terminal</span
          >
        </button>
      </div>
    </div>
    <!-- Global Footer -->
    <footer
      class="flex h-12 items-center justify-between border-t border-white/5 bg-transparent px-8 text-zinc-500"
    >
      <script is:inline src="/jsx/100.shade.js"></script>
      <script is:inline>
        setTimeout(async () => {
          window['SHADE'] = window['SHADE'].hunt;
          const WRITE_SURFACE = '[Write action] Write Surface';
          var bit = await window['SHADE'](WRITE_SURFACE, {
            idx: 'surface00',
            dat: { src: 'surface00' },
            rsz: true,
          });

          var stage = bit.fceBit.dat.bit.stage;

          const WRITE_GRAPHIC = '[Write action] Write Graphic';
          var graphic = await window['SHADE'](WRITE_GRAPHIC, {
            idx: 'graphic00',
            dat: { w: 1500, h: 500, x: 100, y: 100 },
          });
          graphic = graphic.gphBit.dat.bit;

          graphic
            .rect(3, 600, 1457, 300) // x, y, width, height for the rectangle
            .fill({ color: 0x000000 }) // Fill with red
            .stroke({ width: 2, color: 0x000000 }); // Stroke with black

          graphic.alpha = 0.8;
          stage.addChild(graphic);
        }, 222);
      </script>
      <div class="font-mono text-[9px] uppercase tracking-wider">
        © 1978 PORTAL ENTERTAINMENT LTD.
      </div>
      <div
        class="flex space-x-8 font-label text-[9px] font-bold uppercase tracking-widest"
      >
        <a class="transition-colors hover:text-white" href="#"
          >Guild Registers</a
        >
        <a class="transition-colors hover:text-white" href="#">Lore Archives</a>
        <a class="transition-colors hover:text-white" href="#">Mail-Order</a>
      </div>
      <div class="flex items-center gap-4">
        <span
          class="material-symbols-outlined cursor-pointer text-sm hover:text-white"
          >star</span
        >
        <span
          class="material-symbols-outlined cursor-pointer text-sm hover:text-white"
          >shield</span
        >
        <span
          class="material-symbols-outlined cursor-pointer text-sm hover:text-white"
          >inventory_2</span
        >
      </div>
    </footer>
  </div>
</Layout>
