---
import Layout from '../../layouts/Layout.astro';
---

<Layout bodyClass="bg-background-light text-primary font-serif overflow-hidden">
  <div class="flex h-screen w-full border-[12px] border-primary">
    <div class="flex-1 flex flex-col overflow-hidden">
      <header
        class="flex items-center justify-between border-b-2 border-primary bg-background-light px-6 py-4"
      >
        <div class="flex flex-col">
          <h1
            class="font-display text-3xl font-black tracking-tighter uppercase leading-none"
          >
            DM COMMAND CENTER
          </h1>
          <p
            class="font-mono text-[10px] font-bold tracking-widest uppercase mt-1"
          >
            THE TOME: 1970 EDITION | SESSION ACTIVE
          </p>
        </div>
        <div class="flex items-center gap-6">
          <div
            class="border-2 border-primary px-3 py-1 flex items-center bg-white"
          >
            <span class="material-symbols-outlined text-xl mr-2">search</span>
            <input
              class="bg-transparent border-none focus:ring-0 font-mono text-xs uppercase w-40"
              placeholder="LIVE QUERY..."
              type="text"
            />
          </div>
          <div
            class="font-mono text-[10px] font-bold text-right hidden md:block"
          >
            <div class="opacity-50">REGISTERED USER</div>
            <div>ADMIN_01</div>
          </div>
        </div>
      </header>
      <div class="flex-1 flex overflow-hidden">
        <section
          class="w-72 flex-shrink-0 border-r-2 border-primary flex flex-col bg-background-light overflow-y-auto custom-scrollbar"
        >
          <div class="grid-section-header">
            <span class="text-xs">PC STATUS</span>
            <span class="material-symbols-outlined text-sm">person_pin</span>
          </div>
          <div class="p-2 space-y-2">
            <div class="grid-panel !p-3">
              <div class="flex justify-between items-start">
                <h3
                  class="font-display text-lg font-black uppercase leading-tight w-2/3"
                >
                  Dread Knight
                </h3>
                <div
                  class="w-10 h-10 border border-primary grayscale contrast-125 bg-cover bg-center"
                  style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuAKNzjFJmyyAubw75N8PkgeIzleC5ayxs64PjCxfaFXeW-Ak1CSH0oGsFNw5XBKMX1Bl7E7rUJhcQ5vo_p1Sup5KxoqHknA8ZZELdjoVwpHlUbfLdmTFr59OA5LB_6WlmPHfDZvJyYpCY5NnrX_rnsw3qnsO9xIENlFMrupVYLrM6oiOyitkA9HOkyJyftv6cN9M72-4ufzGV6Y-wcP68YPt-WptTx9SfRQjaKC5npPCiwJNR-W50qNPfggVm6gNrE31ygOG-diAPoK");'
                >
                </div>
              </div>
              <div
                class="font-mono text-[10px] grid grid-cols-2 gap-1 border-t border-primary/20 pt-2"
              >
                <span>HP: 84/84</span>
                <span>AC: 18</span>
                <span>LVL: 12</span>
                <span>STR: 18</span>
              </div>
            </div>
            <div class="grid-panel !p-3">
              <div class="flex justify-between items-start">
                <h3
                  class="font-display text-lg font-black uppercase leading-tight w-2/3"
                >
                  Flesh Weaver
                </h3>
                <div
                  class="w-10 h-10 border border-primary grayscale contrast-125 bg-cover bg-center"
                  style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuAKNzjFJmyyAubw75N8PkgeIzleC5ayxs64PjCxfaFXeW-Ak1CSH0oGsFNw5XBKMX1Bl7E7rUJhcQ5vo_p1Sup5KxoqHknA8ZZELdjoVwpHlUbfLdmTFr59OA5LB_6WlmPHfDZvJyYpCY5NnrX_rnsw3qnsO9xIENlFMrupVYLrM6oiOyitkA9HOkyJyftv6cN9M72-4ufzGV6Y-wcP68YPt-WptTx9SfRQjaKC5npPCiwJNR-W50qNPfggVm6gNrE31ygOG-diAPoK");'
                >
                </div>
              </div>
              <div
                class="font-mono text-[10px] grid grid-cols-2 gap-1 border-t border-primary/20 pt-2"
              >
                <span>HP: 62/62</span>
                <span>AC: 15</span>
                <span>LVL: 12</span>
                <span>DEX: 17</span>
              </div>
            </div>
            <div class="grid-panel !p-3">
              <div class="flex justify-between items-start">
                <h3
                  class="font-display text-lg font-black uppercase leading-tight w-2/3"
                >
                  Void Acolyte
                </h3>
                <div
                  class="w-10 h-10 border border-primary grayscale contrast-125 bg-cover bg-center"
                  style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuAKNzjFJmyyAubw75N8PkgeIzleC5ayxs64PjCxfaFXeW-Ak1CSH0oGsFNw5XBKMX1Bl7E7rUJhcQ5vo_p1Sup5KxoqHknA8ZZELdjoVwpHlUbfLdmTFr59OA5LB_6WlmPHfDZvJyYpCY5NnrX_rnsw3qnsO9xIENlFMrupVYLrM6oiOyitkA9HOkyJyftv6cN9M72-4ufzGV6Y-wcP68YPt-WptTx9SfRQjaKC5npPCiwJNR-W50qNPfggVm6gNrE31ygOG-diAPoK");'
                >
                </div>
              </div>
              <div
                class="font-mono text-[10px] grid grid-cols-2 gap-1 border-t border-primary/20 pt-2"
              >
                <span>HP: 45/54</span>
                <span>AC: 12</span>
                <span>LVL: 12</span>
                <span>INT: 19</span>
              </div>
            </div>
            <div class="grid-panel !p-3">
              <div class="flex justify-between items-start">
                <h3
                  class="font-display text-lg font-black uppercase leading-tight w-2/3"
                >
                  Iron Maiden
                </h3>
                <div
                  class="w-10 h-10 border border-primary grayscale contrast-125 bg-cover bg-center"
                  style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuAKNzjFJmyyAubw75N8PkgeIzleC5ayxs64PjCxfaFXeW-Ak1CSH0oGsFNw5XBKMX1Bl7E7rUJhcQ5vo_p1Sup5KxoqHknA8ZZELdjoVwpHlUbfLdmTFr59OA5LB_6WlmPHfDZvJyYpCY5NnrX_rnsw3qnsO9xIENlFMrupVYLrM6oiOyitkA9HOkyJyftv6cN9M72-4ufzGV6Y-wcP68YPt-WptTx9SfRQjaKC5npPCiwJNR-W50qNPfggVm6gNrE31ygOG-diAPoK");'
                >
                </div>
              </div>
              <div
                class="font-mono text-[10px] grid grid-cols-2 gap-1 border-t border-primary/20 pt-2"
              >
                <span>HP: 98/98</span>
                <span>AC: 20</span>
                <span>LVL: 12</span>
                <span>CON: 18</span>
              </div>
            </div>
          </div>
        </section>
        <section
          class="flex-1 flex flex-col bg-white overflow-y-auto custom-scrollbar"
        >
          <div class="grid-section-header">
            <span>SESSION OVERVIEW</span>
            <div class="flex gap-4">
              <span class="text-xs font-mono">VOL. IV / PAGE 666</span>
              <span class="material-symbols-outlined text-sm">edit_note</span>
            </div>
          </div>
          <div class="p-8 max-w-3xl mx-auto w-full">
            <div class="mb-8">
              <h2
                class="font-display text-4xl font-black uppercase border-b-4 border-primary pb-2 mb-4"
              >
                The Forgotten Reach
              </h2>
              <p class="justified-slab text-lg leading-relaxed">
                The party currently stands at the threshold of the frigid
                sepulchers. The spectral echoes of fallen paladins resonate
                through the stone, their noble vows twisted by the necrotic
                resonance of the Void.
              </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
              <div class="border-2 border-primary p-4">
                <h4
                  class="font-mono text-xs font-bold uppercase mb-3 bg-primary text-background-light px-2 py-1 inline-block"
                >
                  Primary Objectives
                </h4>
                <ul class="font-mono text-sm space-y-2">
                  <li class="flex items-start gap-2">
                    <span class="material-symbols-outlined text-sm mt-1"
                      >check_box_outline_blank</span
                    >
                    Locate the Soul-Leeching mechanisms.
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="material-symbols-outlined text-sm mt-1"
                      >check_box_outline_blank</span
                    >
                    Decipher the Liturgy of the Still Heart.
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="material-symbols-outlined text-sm mt-1"
                      >check_box_outline_blank</span
                    >
                    Survive the Necrosis Field in sector 7.
                  </li>
                </ul>
              </div>
              <div class="border-2 border-primary p-4">
                <h4
                  class="font-mono text-xs font-bold uppercase mb-3 bg-primary text-background-light px-2 py-1 inline-block"
                >
                  Grimoire Shortcuts
                </h4>
                <div class="space-y-3">
                  <div class="border-b border-primary pb-1">
                    <div
                      class="flex justify-between font-display font-bold text-sm uppercase"
                    >
                      <span>Necrosis</span>
                      <span>LVL III</span>
                    </div>
                    <p class="text-[10px] opacity-70 italic">
                      Total dissolution of living tissue.
                    </p>
                  </div>
                  <div class="border-b border-primary pb-1">
                    <div
                      class="flex justify-between font-display font-bold text-sm uppercase"
                    >
                      <span>Bone Shatter</span>
                      <span>LVL V</span>
                    </div>
                    <p class="text-[10px] opacity-70 italic">
                      2d10 crushing + paralysis.
                    </p>
                  </div>
                </div>
              </div>
            </div>
            <div class="border-2 border-primary p-6 bg-background-light">
              <h4
                class="font-mono text-xs font-bold uppercase mb-4 text-center border-b border-primary pb-2"
              >
                Dungeon Master's Secret Logs
              </h4>
              <p class="justified-slab text-sm font-serif italic leading-snug">
                Note to players: High-difficulty class. Their inability to heal
                through standard clerical prayers makes them reliant on
                soul-leeching mechanisms found in darker reaches. Each kill
                feeds the blade, and each drop of blood spilled serves to
                lubricate the grinding gears of their eternal existence.
              </p>
            </div>
          </div>
        </section>
        <section
          class="w-72 flex-shrink-0 border-l-2 border-primary flex flex-col bg-background-light overflow-y-auto custom-scrollbar"
        >
          <div class="grid-section-header">
            <span class="text-xs">BESTIARY LOOKUP</span>
            <span class="material-symbols-outlined text-sm">skull</span>
          </div>
          <div class="p-2 space-y-2">
            <div class="grid-panel !p-3">
              <div class="flex justify-between items-start">
                <h3
                  class="font-display text-lg font-black uppercase leading-tight w-2/3"
                >
                  Grave Stalker
                </h3>
                <div
                  class="w-10 h-10 border border-primary grayscale contrast-125 bg-cover bg-center"
                  style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuAKNzjFJmyyAubw75N8PkgeIzleC5ayxs64PjCxfaFXeW-Ak1CSH0oGsFNw5XBKMX1Bl7E7rUJhcQ5vo_p1Sup5KxoqHknA8ZZELdjoVwpHlUbfLdmTFr59OA5LB_6WlmPHfDZvJyYpCY5NnrX_rnsw3qnsO9xIENlFMrupVYLrM6oiOyitkA9HOkyJyftv6cN9M72-4ufzGV6Y-wcP68YPt-WptTx9SfRQjaKC5npPCiwJNR-W50qNPfggVm6gNrE31ygOG-diAPoK");'
                >
                </div>
              </div>
              <p class="font-serif text-[11px] leading-tight opacity-80">
                Creatures that emerge from the frigid sepulchers. Their presence
                marked only by ancient parchment.
              </p>
              <div
                class="mt-2 font-mono text-[10px] flex justify-between uppercase border-t border-primary/20 pt-2"
              >
                <span>CR: 12</span>
                <span>PG: 402</span>
              </div>
            </div>
            <div class="grid-panel !p-3">
              <div class="flex justify-between items-start">
                <h3
                  class="font-display text-lg font-black uppercase leading-tight w-2/3"
                >
                  Soul Reaper
                </h3>
                <div
                  class="w-10 h-10 border border-primary grayscale contrast-125 bg-cover bg-center"
                  style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuAKNzjFJmyyAubw75N8PkgeIzleC5ayxs64PjCxfaFXeW-Ak1CSH0oGsFNw5XBKMX1Bl7E7rUJhcQ5vo_p1Sup5KxoqHknA8ZZELdjoVwpHlUbfLdmTFr59OA5LB_6WlmPHfDZvJyYpCY5NnrX_rnsw3qnsO9xIENlFMrupVYLrM6oiOyitkA9HOkyJyftv6cN9M72-4ufzGV6Y-wcP68YPt-WptTx9SfRQjaKC5npPCiwJNR-W50qNPfggVm6gNrE31ygOG-diAPoK");'
                >
                </div>
              </div>
              <p class="font-serif text-[11px] leading-tight opacity-80">
                Each kill feeds their existence. They seek the total dissolution
                of the world's spiritual anchors.
              </p>
              <div
                class="mt-2 font-mono text-[10px] flex justify-between uppercase border-t border-primary/20 pt-2"
              >
                <span>CR: 20</span>
                <span>PG: 512</span>
              </div>
            </div>
          </div>
        </section>
      </div>
      <footer
        class="bg-primary text-background-light px-6 py-2 flex justify-between items-center font-mono text-[9px] uppercase tracking-widest border-t-2 border-primary"
      >
        <div class="flex gap-4">
          <span>© 1974 CHRONOS SYSTEMS</span>
          <span class="hidden md:inline">|</span>
          <span>PRINTED IN THE KINGDOM OF AEON</span>
        </div>
        <div class="flex gap-6">
          <span>ACTIVE ENTRIES: 666</span>
          <span class="text-green-400">STATUS: ONLINE</span>
        </div>
      </footer>
    </div>
  </div>
</Layout>

<style>
  @reference "../../styles/global.css";

  .grid-panel {
    @apply border-2 border-primary bg-background-light p-4 flex flex-col gap-3 hover:bg-white transition-colors cursor-pointer;
  }
  .grid-section-header {
    @apply border-b-2 border-primary bg-primary text-background-light px-4 py-2 font-display font-black uppercase tracking-widest flex justify-between items-center sticky top-0 z-10;
  }
  .sidebar-link {
    @apply flex flex-col items-center justify-center py-6 border-b-2 border-primary hover:bg-primary hover:text-background-light transition-all;
  }
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: var(--color-background-light);
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: var(--color-primary);
  }
</style>
