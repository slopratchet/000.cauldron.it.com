---
import Layout from '../layouts/Layout.astro';
import CharacterSheet from '../components/character-sheet/CharacterSheet.tsx';
---

<Layout bodyClass="cimmerian-theme">
  <!-- We add the fonts needed for the Cimmerian Sheet -->
  <link
    href="https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,400&display=swap"
    rel="stylesheet"
  />
  <CharacterSheet client:load />
</Layout>
