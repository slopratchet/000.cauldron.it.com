---
//var iframeUrlStr = import.meta.env.PUBLIC_IFRAME_URL;

var iframeUrlStr = 'https://002-primal-mama-mobile-control.pages.dev/';
//if (iframeUrlStr == null) iframeUrlStr = 'none';
//if (iframeUrlStr == 'none')
//  iframeUrlStr = 'https://002-primal-mama-mobile-control.pages.dev/';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Camp Candor</title>
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
      }
      iframe {
        width: 100%;
        height: 100%;
        border: none;
        display: block;
      }
    </style>
  </head>
  <body>
    <iframe
      id="app-iframe"
      title="Full Screen View"
      data-iframe-url={iframeUrlStr}></iframe>

    <script>
      import { $clerkStore } from '@clerk/astro/client';

      const iframe = document.getElementById('app-iframe');

      // Fallback URL if data attribute is missing
      let baseUrl = 'https://002-primal-mama-mobile-control.pages.dev/';
      if (
        iframe &&
        iframe.dataset.iframeUrl &&
        iframe.dataset.iframeUrl !== 'none'
      ) {
        baseUrl = iframe.dataset.iframeUrl;
      }

      let clerkRetries = 0;
      const initIframe = async () => {
        const clerk = $clerkStore.get();
        const hasPublishableKey = !!import.meta.env
          .PUBLIC_CLERK_PUBLISHABLE_KEY;

        // Ensure clerk exists AND is fully loaded (so session is populated)
        if (!clerk || !clerk.loaded) {
          clerkRetries++;
          if (clerkRetries < 30) {
            // Try for 3 seconds max (30 * 100ms)
            setTimeout(initIframe, 100);
            return;
          }
          console.warn(
            'Clerk failed to load within 3 seconds. Initializing iframe without token. hasPublishableKey: ' +
              hasPublishableKey,
          );
        }

        let token = null;
        try {
          if (clerk && clerk.session) {
            token = await clerk.session.getToken();
            console.log(
              '🖥️ [iframe.astro] Clerk token successfully obtained:',
              token
                ? 'YES (truncated: ' + token.substring(0, 10) + '...)'
                : 'NO (null/empty)',
            );
          } else {
            console.log(
              '🖥️ [iframe.astro] Clerk or clerk.session is missing. clerk exists:',
              !!clerk,
              'clerk.loaded:',
              clerk?.loaded,
              'clerk.session exists:',
              !!clerk?.session,
            );
          }
        } catch (err) {
          console.error(
            '🖥️ [iframe.astro] Error fetching Clerk token client-side:',
            err,
          );
        }

        let finalIframeUrl = baseUrl;
        if (token) {
          if (finalIframeUrl.indexOf('?') === -1) {
            finalIframeUrl += '?token=' + encodeURIComponent(token);
          } else {
            finalIframeUrl += '&token=' + encodeURIComponent(token);
          }
          console.log('🖥️ [iframe.astro] Appending token to iframe URL');
        } else {
          console.log(
            '🖥️ [iframe.astro] No token found, loading iframe URL without token',
          );
        }

        if (iframe) {
          console.log(
            '🖥️ [iframe.astro] Setting iframe.src to:',
            finalIframeUrl,
          );
          // Set the src with the token in the URL first
          iframe.src = finalIframeUrl;

          // Also attempt postMessage for apps that prefer it,
          // but ensure it happens after load
          if (token) {
            console.log(
              '🖥️ [iframe.astro] Token exists, adding iframe.onload handler for postMessage',
            );
            iframe.onload = function () {
              console.log(
                '🖥️ [iframe.astro] iframe.onload fired, preparing postMessage...',
              );
              if (iframe.contentWindow) {
                console.log(
                  '🖥️ [iframe.astro] Sending CLERK_AUTH_TOKEN postMessage to iframe',
                );
                iframe.contentWindow.postMessage(
                  { type: 'CLERK_AUTH_TOKEN', payload: { token: token } },
                  '*',
                );
              } else {
                console.warn(
                  '🖥️ [iframe.astro] iframe.contentWindow is null, cannot send postMessage',
                );
              }
            };
          }
        }
      };

      initIframe();
    </script>
  </body>
</html>
