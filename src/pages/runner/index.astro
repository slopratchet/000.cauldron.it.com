    <div class="font-label text-[10px] tracking-widest uppercase">
      CHRONOS SYSTEMS | PRINTED IN THE KINGDOM OF MANOR | STATUS: <span
        id="status-indicator"
        class={isOnline ? 'text-green-400' : 'text-red-400'}>{status}</span
      >
    </div>
    <div class="flex gap-6 font-label text-[10px] tracking-widest uppercase">
      <a class="opacity-80 hover:opacity-100 hover:underline" href="#"
        >SYSTEM LOGS</a
