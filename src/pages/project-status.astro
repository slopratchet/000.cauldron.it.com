---
import Layout from '../layouts/Layout.astro';
import ProjectStatus from '../components/ProjectStatus.tsx';
import '../styles/global.css';

// SECTOR_RECOVERY_PROTOCOL: Automatic Redirect if already verified
const auth = Astro.locals.auth();
const isLocal =
  Astro.url.hostname === 'localhost' || Astro.url.hostname === '127.0.0.1';

if (!auth.userId && !isLocal) {
  const target = '/log-in';
  return Astro.redirect(target);
}
---

<Layout title="Project Status">
  <ProjectStatus client:load />
</Layout>
