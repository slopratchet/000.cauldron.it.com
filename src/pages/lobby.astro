---
import Layout from '../layouts/Layout.astro';
import CharacterSheet from '../components/character-sheet/CharacterSheet.tsx';

let status = 'OFFLINE';

const isOnline = status === 'ONLINE';
---

<Layout bodyClass="cimmerian-theme">
  <!-- We add the fonts needed for the Cimmerian Sheet -->

  LOBBY

  <div class="font-label text-[10px] tracking-widest uppercase">
    CAMP CANDOR SYSTEMS | PRINTED IN THE KINGDOM OF MANOR | STATUS: <span
      id="status-indicator"
      class={isOnline ? 'text-green-400' : 'text-red-400'}>{status}</span
    >
  </div>
</Layout>
