---
import Layout from '../layouts/Layout.astro';
import LobbyIndex from '../components/lobby-index/LobbyIndex.tsx';

let status = 'OFFLINE';
try {
  const response = await fetch(new URL('/api/moon', Astro.url));
  if (response.ok) {
    status = 'WAITING';
  }
} catch (e) {
  console.error('Failed to fetch system status:', e);
}
---

<Layout bodyClass="cimmerian-theme">
  <!-- We add the fonts needed for the Cimmerian Sheet -->

  <LobbyIndex client:load />

  <div class="max-w-7xl mx-auto w-full px-4 md:px-8 pb-12 mt-0 relative z-10">
    <div class="flex justify-between items-center mb-4">
      <span class="text-2xl font-bold uppercase tracking-tighter">LOBBY</span>
      <a
        href="/log-out"
        class="border-2 border-primary bg-paper px-4 py-1.5 font-display text-[10px] font-bold uppercase tracking-widest hover:bg-primary hover:text-paper transition-all active:scale-95"
      >
        LOG_OUT
      </a>
    </div>

    <div class="font-label text-[10px] tracking-widest uppercase">
      CAMP CANDOR SYSTEMS | PRINTED IN THE KINGDOM OF MANOR | STATUS: <span
        id="status-indicator"
        class={status === 'ONLINE'
          ? 'text-green-400'
          : status === 'WAITING'
            ? 'text-yellow-400'
            : 'text-red-400'}>{status}</span
      >
    </div>

    <a
      href="/000.pdf"
      class="mt-4 block w-full border-2 border-black bg-[#E6E2D8] text-black py-3 text-center font-mono font-bold hard-shadow-sm uppercase tracking-wider hover:bg-black hover:text-white transition-colors"
      download
    >
      Download pdf of [campaign settings ]
    </a>
  </div>

  <script>
    import { $clerkStore } from '@clerk/astro/client';

    // WebSocket Connection
    {
      let ws;
      let pendingCharacterSelect = null;
      let usingFallback = false;
      let retryCount = 0;
      let hasReceivedTick = false;
      const MAX_RETRIES = 10;

      const EFFORT_MESSAGES = [
        'RE-ESTABLISHING NEURAL LINK',
        'CALIBRATING SIGNAL AMPLITUDE',
        'BYPASSING ENCRYPTION BARRIER',
        'SYNCHRONIZING TEMPORAL DATA',
        'HARNESSING KINETIC ENERGY',
        'REDIRECTING POWER TO TRANSMITTER',
        'STABILIZING QUANTUM TUNNEL',
        'PROBING VOID FOR SIGNAL',
        'AMPLIFYING SUB-SPACE RESONANCE',
        'OPTIMIZING DATA PACKET FLOW',
      ];

      const appendLog = (htmlContent, type = 'INFO') => {
        // Dispatch a custom event for the LobbyIndex component to catch
        // Strip HTML tags for the text-only system log
        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = htmlContent;
        const plainText = tempDiv.textContent || tempDiv.innerText || '';

        console.log(`[LobbyHost] [${type}] ${plainText}`);

        window.dispatchEvent(
          new CustomEvent('lobby-system-log', {
            detail: { text: plainText, type },
          }),
        );
      };

      const getToken = async () => {
        let clerk = $clerkStore.get();
        let retry = 0;
        while ((!clerk || !clerk.loaded) && retry < 50) {
          await new Promise((resolve) => setTimeout(resolve, 100));
          clerk = $clerkStore.get();
          retry++;
        }
        if (clerk && clerk.session) {
          try {
            return (await clerk.session.getToken()) || '';
          } catch (e) {
            console.error('Error fetching session token:', e);
          }
        }
        return '';
      };

      const connect = async (isFallback = false) => {
        const token = await getToken();
        let url;
        if (isFallback) {
          url = `wss://worker-warden.berad4000.workers.dev/ws${token ? `?jwt=${encodeURIComponent(token)}` : ''}`;
        } else {
          const protocol =
            window.location.protocol === 'https:' ? 'wss:' : 'ws:';
          url = `${protocol}//${window.location.host}/api/sun${token ? `?jwt=${encodeURIComponent(token)}` : ''}`;
        }

        ws = new WebSocket(url);

        ws.onopen = () => {
          retryCount = 0;
          appendLog(
            `[SYSTEM] ✨ NEURAL LINK ESTABLISHED via ${isFallback ? 'direct worker fallback' : 'API /api/sun'}. All systems operational. Waiting for ticks...`,
            'SUCCESS',
          );
          // Dictate LOBBY role to suppress high-frequency simulation ticks
          ws.send(JSON.stringify({ type: 'DEVICE_ROLE', role: 'LOBBY' }));

          // Execute initial CHARACTER_SELECT dispatch if queued, otherwise check URL query param
          const initialSelect =
            pendingCharacterSelect ||
            (() => {
              const params = new URLSearchParams(window.location.search);
              const actor = params.get('actor');
              return actor
                ? { type: 'CHARACTER_SELECT', characterId: actor }
                : null;
            })();

          if (initialSelect) {
            ws.send(JSON.stringify(initialSelect));
            appendLog(
              `[SYSTEM] Relaying agent selection coordinates to core... [${initialSelect.characterId}]`,
              'INFO',
            );
            pendingCharacterSelect = null;
          }
        };

        ws.onmessage = (event) => {
          if (!hasReceivedTick) {
            hasReceivedTick = true;
            document.getElementById('status-indicator').innerText = 'ONLINE';
            document.getElementById('status-indicator').className =
              'text-green-400';
          }
          let data = event.data;
          try {
            const parsed = JSON.parse(data);
            if (parsed && parsed.type === 'auth_status') {
              const { userId, mockAuth } = parsed.payload;
              if (mockAuth) {
                appendLog(
                  `<span class="text-yellow-500">[SECURITY ALERT] Neural Link established using MOCK DEVELOPMENT AUTH BYPASS (User: ${userId}).</span>`,
                  'WARNING',
                );
              } else {
                appendLog(
                  `<span class="text-cyan-400">[IDENTITY CONFIRMED] Warden verification successful for User: ${userId}.</span>`,
                  'SUCCESS',
                );
              }
              return;
            }
            if (parsed && parsed.type === 'device_role_acknowledged') {
              appendLog(
                `[SYSTEM] Role acknowledged as [${parsed.payload?.role}].`,
                'SUCCESS',
              );
              return;
            }
            if (parsed && parsed.type === 'sower_backup_complete') {
              appendLog(
                `<span class="text-green-400">[ARCHIVIST] Database entity successfully backed up to cold storage in background.</span>`,
                'SUCCESS',
              );
              return;
            }
            if (parsed && parsed.type === 'sower_backup_failed') {
              appendLog(
                `<span class="text-red-500">[ARCHIVIST WARNING] Out-of-band backup failed: ${parsed.payload?.error || 'Unknown error'}. Check server credentials and R2 bindings.</span>`,
                'WARNING',
              );
              return;
            }
            if (parsed && parsed.type === 'character_swapped') {
              appendLog(
                `<span class="text-cyan-400">[ACTOR ENGINE] Character session successfully hot-swapped to [${parsed.payload?.characterId}] in memory.</span>`,
                'SUCCESS',
              );
              return;
            }
            if (parsed && parsed.type === 'spatial_diagnostic') {
              appendLog(
                `<span class="text-fuchsia-400">[SPATIAL HIERARCHY] ${parsed.payload?.message}</span>`,
                'INFO',
              );
              return;
            }
            if (parsed && parsed.type === 'gillian_diagnostic') {
              appendLog(
                `<span class="text-orange-400">[GILLIAN-BASE] ${parsed.payload?.message}</span>`,
                'INFO',
              );
              return;
            }
            if (parsed && parsed.type === 'deterministic_diagnostic') {
              appendLog(
                `<span class="text-blue-400">[PURE FUNCTION] ${parsed.payload?.message}</span>`,
                'INFO',
              );
              return;
            }
            if (parsed && parsed.type === 'straightjacket_diagnostic') {
              appendLog(
                `<span class="text-emerald-400">[STRAIGHTJACKET] ${parsed.payload?.message}</span>`,
                'INFO',
              );
              return;
            }
            if (parsed && parsed.type === 'spatial_integrity_diagnostic') {
              appendLog(
                `<span class="text-purple-400">[SPATIAL INTEGRITY] ${parsed.payload?.message}</span>`,
                'INFO',
              );
              return;
            }
            if (parsed && parsed.type === 'nomad_diagnostic') {
              const isError =
                parsed.payload?.message?.includes('[CRITICAL FAILURE]');
              appendLog(
                `<span class="${isError ? 'text-red-500 font-bold' : 'text-amber-400'}">[THE NOMAD] ${parsed.payload?.message}</span>`,
                isError ? 'ERROR' : 'INFO',
              );
              return;
            }
            if (parsed && parsed.type === 'warden_diagnostic') {
              const isError =
                parsed.payload?.message?.includes('[CRITICAL FAILURE]');
              appendLog(
                `<span class="${isError ? 'text-red-500 font-bold' : 'text-teal-400'}">[WARDEN] ${parsed.payload?.message}</span>`,
                isError ? 'ERROR' : 'INFO',
              );
              return;
            }
            data = JSON.stringify(parsed);
          } catch (e) {}
          appendLog(
            `<span class="text-white">[TICK]</span> ${data}`,
            'SUCCESS',
          );
        };

        ws.onerror = (error) => {
          if (!usingFallback) {
            usingFallback = true;
            appendLog(
              '<span class="text-yellow-500">[SYSTEM] Connection via /api/sun failed. Will retry with direct worker fallback...</span>',
              'WARNING',
            );
          } else {
            appendLog(
              '<span class="text-red-500">[ERROR] Connection failed.</span>',
              'ALERT',
            );
          }
        };

        ws.onclose = (event) => {
          document.getElementById('status-indicator').innerText = 'OFFLINE';
          document.getElementById('status-indicator').className =
            'text-red-400';

          const reason = event.reason ? `: ${event.reason}` : '';
          appendLog(
            `[SYSTEM] CONNECTION CLOSED. (CODE: ${event.code}${reason})`,
            'WARNING',
          );

          if (retryCount < MAX_RETRIES) {
            retryCount++;
            const effort =
              EFFORT_MESSAGES[
                Math.floor(Math.random() * EFFORT_MESSAGES.length)
              ];
            const progress = Math.round((retryCount / MAX_RETRIES) * 10);
            const bar = '█'.repeat(progress) + '░'.repeat(10 - progress);

            appendLog(
              `[SYSTEM] ${effort} [${bar}] (ATTEMPT ${retryCount}/${MAX_RETRIES})`,
              'INFO',
            );

            setTimeout(() => {
              connect(usingFallback);
            }, 3000);
          } else {
            appendLog(
              '[SYSTEM] MAXIMUM RECONNECTION ATTEMPTS EXHAUSTED. TERMINAL OFFLINE.',
              'ALERT',
            );
          }
        };
      };

      connect();

      window.addEventListener('lobby-ws-send', (e: any) => {
        if (ws && ws.readyState === WebSocket.OPEN) {
          ws.send(JSON.stringify(e.detail));
          appendLog(
            `[SYSTEM] Relaying agent selection coordinates to core... [${e.detail.characterId}]`,
            'INFO',
          );
        } else {
          pendingCharacterSelect = e.detail;
        }
      });
    }
  </script>
</Layout>
