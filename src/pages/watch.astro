---
import Layout from '../layouts/Layout.astro';
---

<Layout
  bodyClass="font-newsreader text-on-surface bg-watch-texture min-h-screen flex flex-col"
>
  <main class="flex-1 w-full max-w-5xl mx-auto p-4 md:p-6 space-y-6">
    <!-- Countdown Section -->
    <section class="border-[3px] border-black bg-surface p-6 relative">
      <div
        class="absolute -top-3 left-1/2 -translate-x-1/2 bg-surface px-2 font-jetbrains-mono text-[10px] font-bold border border-black uppercase tracking-widest"
      >
        [CURRENT TIME]
      </div>
      <div
        class="flex justify-center items-center gap-2 md:gap-4 font-jetbrains-mono font-black text-5xl md:text-7xl"
      >
        <!-- Year -->
        <div class="flex flex-col items-center">
          <div
            class="border-[3px] border-black bg-white px-2 py-1 relative overflow-hidden shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"
          >
            <div class="absolute top-1/2 left-0 w-full h-0.5 bg-black z-10">
            </div>
            <span class="">26</span>
          </div>
          <span
            class="bg-black text-white text-[10px] px-2 py-0.5 mt-1 w-full text-center"
            >26</span
          >
        </div>
        <span class="">:</span>
        <!-- Days -->
        <div class="flex flex-col items-center">
          <div
            class="border-[3px] border-black bg-white px-2 py-1 relative overflow-hidden shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"
          >
            <div class="absolute top-1/2 left-0 w-full h-0.5 bg-black z-10">
            </div>
            <span class="">000</span>
          </div>
          <span
            class="bg-black text-white text-[10px] px-2 py-0.5 mt-1 w-full text-center"
            >DAY</span
          >
        </div>
        <span class="">:</span>
        <!-- Hours -->
        <div class="flex flex-col items-center">
          <div
            class="border-[3px] border-black bg-white px-2 py-1 relative overflow-hidden shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"
          >
            <div class="absolute top-1/2 left-0 w-full h-0.5 bg-black z-10">
            </div>
            <span class="">00</span>
          </div>
          <span
            class="bg-black text-white text-[10px] px-2 py-0.5 mt-1 w-full text-center"
            >HRS</span
          >
        </div>
        <span class="">:</span>
        <!-- Minutes -->
        <div class="flex flex-col items-center">
          <div
            class="border-[3px] border-black bg-white px-2 py-1 relative overflow-hidden shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"
          >
            <div class="absolute top-1/2 left-0 w-full h-0.5 bg-black z-10">
            </div>
            <span class="">03</span>
          </div>
          <span
            class="bg-black text-white text-[10px] px-2 py-0.5 mt-1 w-full text-center"
            >MIN</span
          >
        </div>
        <span class="">:</span>
        <!-- Seconds -->
        <div class="flex flex-col items-center">
          <div
            class="border-[3px] border-black bg-white px-2 py-1 relative overflow-hidden shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"
          >
            <div class="absolute top-1/2 left-0 w-full h-0.5 bg-black z-10">
            </div>
            <span class="">33</span>
          </div>
          <span
            class="bg-black text-white text-[10px] px-2 py-0.5 mt-1 w-full text-center"
            >SEC</span
          >
        </div>
      </div>
    </section>
    <!-- Black Monolith Core Section -->
    <section
      class="bg-black p-4 md:p-6 border-[3px] border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,0.2)]"
    >
      <!-- Command Override Terminal -->
      <div class="mb-6">
        <div
          class="flex justify-between items-center text-[#00ff00] font-jetbrains-mono text-[10px] mb-2 uppercase font-bold"
        >
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[12px]">settings</span>
            <span class="">OPERATIONAL LANDSCAPE</span>
          </div>
          <button class="hover:underline">OPEN FULL SCREEN</button>
        </div>
        <div
          class="relative w-full h-[300px] border-2 border-[#00ff00] bg-[#00ff00] overflow-hidden group"
          style="width: 1280px; height: 720px; max-width: 100%;"
        >
          <!-- Scanlines -->
          <div
            class="absolute inset-0 bg-watch-scanlines opacity-40 pointer-events-none mix-blend-overlay"
          >
          </div>
          <!-- Monitor content -->
          <div
            class="w-full h-full bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-black/20 via-[#00ff00]/10 to-transparent mix-blend-multiply"
          >
          </div>
          <!-- Overlay Data -->
          <div
            class="absolute top-2 left-2 bg-[#00ff00]/20 border border-black p-1 text-black font-jetbrains-mono text-[10px] font-bold backdrop-blur-sm shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"
          >
            <div class="">LOC: BOG_EXT_04</div>
            <div class="">POS: 0, 0</div>
          </div>
          <!-- Radar lines -->
          <div
            class="absolute top-1/2 left-1/2 w-[1px] h-full bg-black/30 -translate-x-1/2 -translate-y-1/2"
          >
          </div>
          <div
            class="absolute top-1/2 left-1/2 h-[1px] w-full bg-black/30 -translate-x-1/2 -translate-y-1/2"
          >
          </div>
          <div
            class="absolute top-1/2 left-1/2 w-3/4 h-3/4 border border-black/30 rounded-full -translate-x-1/2 -translate-y-1/2"
          >
          </div>
        </div>
      </div><div class="flex gap-4 mb-8">
        <div
          class="flex-1 bg-surface-container border-[3px] border-white/50 p-3 h-24"
        >
          <textarea
            class="w-full h-full bg-transparent border-none focus:ring-0 p-0 font-jetbrains-mono text-xs text-black resize-none"
            placeholder="ENTER COMMAND OVERRIDE..."></textarea>
        </div>
        <button
          class="border-[3px] border-white text-white font-jetbrains-mono font-bold text-sm px-6 hover:bg-white hover:text-black transition-colors shadow-[4px_4px_0px_0px_rgba(255,255,255,0.2)]"
          style="background-color: rgb(145, 130, 49);">SEND</button
        >
      </div>
      <!-- Operational Landscape (Green Monitor) -->
    </section>
    <section
      class="bg-black p-4 md:p-6 border-[3px] border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,0.2)]"
    >
      <div
        class="flex justify-between items-center border-b border-white/20 pb-2 mb-6"
      >
        <h2
          class="font-jetbrains-mono text-white text-sm font-bold tracking-widest uppercase"
        >
          CHARACTER MAPPING
        </h2>
        <div class="flex gap-4 text-white font-jetbrains-mono text-xl">
          <button class="hover:text-gray-400 transition-colors">&lt;—</button>
          <button class="hover:text-gray-400 transition-colors">—&gt;</button>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div
          class="border-2 border-white/30 bg-white/80 p-8 flex items-center justify-center cursor-pointer hover:bg-white transition-colors"
        >
          <span class="font-jetbrains-mono text-black font-bold">[000]</span>
        </div>
        <div
          class="border-2 border-white/30 p-8 flex items-center justify-center cursor-pointer hover:bg-white/10 transition-colors"
        >
          <span class="font-jetbrains-mono text-white font-bold">[001]</span>
        </div>
        <div
          class="border-2 border-white/30 p-8 flex items-center justify-center cursor-pointer hover:bg-white/10 transition-colors"
        >
          <span class="font-jetbrains-mono text-white font-bold">[002]</span>
        </div>
        <div
          class="border-2 border-white/30 p-8 flex items-center justify-center cursor-pointer hover:bg-white/10 transition-colors md:col-start-1"
        >
          <span class="font-jetbrains-mono text-white font-bold">[003]</span>
        </div>
        <div
          class="border-2 border-white/30 p-8 flex items-center justify-center cursor-pointer hover:bg-white/10 transition-colors"
        >
          <span class="font-jetbrains-mono text-white font-bold">[004]</span>
        </div>
        <div
          class="border-2 border-white/30 p-8 flex items-center justify-center cursor-pointer hover:bg-white/10 transition-colors"
        >
          <span class="font-jetbrains-mono text-white font-bold">[005]</span>
        </div>
      </div>
    </section>
  </main>
  <header class="w-full border-t-[3px] border-black p-6 bg-surface z-10">
    <div class="max-w-5xl mx-auto">
      <div
        class="border-[4px] border-black bg-surface-container-low p-4 text-center shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
      >
        <h1
          class="font-jetbrains-mono font-black text-4xl md:text-6xl tracking-tighter uppercase"
        >
          [FORK SETTING]
        </h1>
      </div>
    </div>
  </header>
</Layout>
