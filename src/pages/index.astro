---
import Layout from '../layouts/Layout.astro';

// SECTOR_RECOVERY_PROTOCOL: Automatic Redirect if already verified
const auth = Astro.locals.auth();
const isLocal =
  Astro.url.hostname === 'localhost' || Astro.url.hostname === '127.0.0.1';
if (auth.userId || isLocal) {
  const target = '/character';
  return Astro.redirect(target);
}
---

<Layout title="Login | Protocol Entry Point">
  <main
    class="flex-1 flex items-center justify-center p-8 min-h-screen relative overflow-hidden"
  >
    <div class="w-full max-w-md">
      <div class="border-4 border-primary bg-paper p-8 relative z-10">
        <div
          class="absolute -top-4 left-4 bg-primary text-paper px-4 py-1 font-display text-xs font-bold tracking-widest uppercase"
        >
          PROTOCOL ENTRY POINT
        </div>

        <div class="mb-10 mt-4 text-center">
          <h2
            class="font-display font-black text-3xl uppercase leading-none tracking-tighter mb-2 text-primary"
          >
            MAMA VERIFICATION
          </h2>
          <div class="h-1 w-12 bg-primary mx-auto"></div>
        </div>

        <form id="login-form" class="space-y-6">
          <div id="credentials-sector" class="space-y-6">
            <div class="space-y-1">
              <label
                class="font-display text-[10px] font-bold uppercase tracking-widest opacity-60 text-primary"
              >
                USER_IDENTIFIER
              </label>
              <input
                id="identifier"
                name="identifier"
                required
                class="w-full border-2 border-primary bg-paper px-4 py-3 font-display text-sm focus:ring-0 focus:bg-white outline-none uppercase placeholder:opacity-30 text-primary transition-colors"
                placeholder="ENTER ID..."
                type="text"
              />
            </div>

            <div class="space-y-1">
              <label
                class="font-display text-[10px] font-bold uppercase tracking-widest opacity-60 text-primary"
              >
                ACCESS_PHRASE
              </label>
              <input
                id="password"
                name="password"
                required
                class="w-full border-2 border-primary bg-paper px-4 py-3 font-display text-sm focus:ring-0 focus:bg-white outline-none placeholder:opacity-30 text-primary transition-colors"
                placeholder="••••••••"
                type="password"
              />
            </div>
            <div class="flex justify-end">
              <button
                id="forgot-password-btn"
                type="button"
                class="font-display text-[9px] font-bold uppercase tracking-widest text-primary opacity-60 hover:opacity-100 hover:underline transition-all"
              >
                FORGOT_PHRASE?
              </button>
            </div>
          </div>

          <div
            id="reset-sector"
            class="hidden space-y-6 animate-in fade-in slide-in-from-bottom-4 duration-500"
          >
            <div class="space-y-1">
              <label
                class="font-display text-[10px] font-bold uppercase tracking-widest opacity-60 text-primary"
              >
                VERIFICATION_CODE
              </label>
              <input
                id="reset_code"
                name="reset_code"
                class="w-full border-2 border-primary bg-paper px-4 py-3 font-display text-lg font-black tracking-[0.5em] text-center focus:ring-0 focus:bg-white outline-none text-primary transition-colors"
                placeholder="000000"
                type="text"
                maxlength="6"
              />
            </div>

            <div class="space-y-1">
              <label
                class="font-display text-[10px] font-bold uppercase tracking-widest opacity-60 text-primary"
              >
                NEW_ACCESS_PHRASE
              </label>
              <input
                id="new_password"
                name="new_password"
                class="w-full border-2 border-primary bg-paper px-4 py-3 font-display text-sm focus:ring-0 focus:bg-white outline-none placeholder:opacity-30 text-primary transition-colors"
                placeholder="••••••••"
                type="password"
              />
            </div>
          </div>

          <div
            id="verification-sector"
            class="hidden space-y-4 animate-in fade-in slide-in-from-bottom-4 duration-500"
          >
            <div class="space-y-1">
              <label
                class="font-display text-[10px] font-bold uppercase tracking-widest opacity-60 text-primary"
              >
                VERIFICATION_CODE (SENT TO EMAIL)
              </label>
              <input
                id="verification_code"
                name="verification_code"
                class="w-full border-2 border-primary bg-paper px-4 py-3 font-display text-lg font-black tracking-[0.5em] text-center focus:ring-0 focus:bg-white outline-none text-primary transition-colors"
                placeholder="000000"
                type="text"
                maxlength="6"
              />
              <p
                class="text-[8px] font-bold uppercase opacity-40 text-center tracking-tighter"
              >
                SECURE CHANNEL: CHECK INBOX FOR 6-DIGIT PULSE
              </p>
            </div>
          </div>

          <div
            id="error-message"
            class="hidden border-l-2 border-red-600 bg-red-50 p-2 font-display text-[10px] font-bold uppercase text-red-600 tracking-tight"
          >
          </div>

          <div class="pt-4">
            <button
              id="submit-btn"
              type="submit"
              class="w-full bg-primary text-paper font-display font-black text-sm py-4 uppercase tracking-[0.2em] hover:bg-white hover:text-primary border-2 border-transparent hover:border-primary transition-all active:scale-[0.98] disabled:opacity-50 disabled:cursor-wait"
            >
              INITIALIZE_SESSION
            </button>
          </div>
        </form>

        <div
          class="mt-8 pt-6 border-t border-primary/10 flex justify-between items-center font-display text-[8px] font-bold opacity-40 uppercase tracking-widest text-primary"
        >
          <span>SECURED_CHANNEL_A1</span>
          <span>ENC: RSA-4096</span>
        </div>
      </div>
    </div>
  </main>

  <style>
    /* Biopunk-Noir Background Pattern */
    main::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
      opacity: 0.06;
      background-image: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 20 L10 10 L30 10 L40 20 L30 30 L10 30 Z' fill='none' stroke='%23000' stroke-width='1'/%3E%3C/svg%3E");
      background-size: 40px 40px;
    }
  </style>

  <script>
    import { $clerkStore } from '@clerk/astro/client';

    console.log('BIO_PUNK_UI: INITIALIZING_SCRIPT_LOAD');

    // Subscribe to store to handle the case where user is already signed in on client side
    const unsubscribe = $clerkStore.subscribe((clerk) => {
      if (clerk && clerk.user) {
        console.log('BIO_PUNK_UI: USER_ALREADY_AUTHENTICATED_REDIRECTING');
        window.location.href = '/character';
      }
    });

    // Selectors for the Biopunk UI

    const loginForm = document.getElementById('login-form') as HTMLFormElement;
    const errorDiv = document.getElementById('error-message');
    const submitBtn = document.getElementById(
      'submit-btn',
    ) as HTMLButtonElement;
    const identifierInput = document.getElementById(
      'identifier',
    ) as HTMLInputElement;
    const passwordInput = document.getElementById(
      'password',
    ) as HTMLInputElement;

    console.log('BIO_PUNK_UI: SELECTORS_READY', {
      hasForm: !!loginForm,
      hasBtn: !!submitBtn,
      clerkReady: !!$clerkStore.get(),
      publishableKey:
        import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY?.substring(0, 10) + '...',
    });

    // UI SECTORS
    const credentialsSector = document.getElementById('credentials-sector');
    const verificationSector = document.getElementById('verification-sector');
    const resetSector = document.getElementById('reset-sector');
    const forgotPasswordBtn = document.getElementById('forgot-password-btn');

    if (
      import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY?.startsWith('pk_test_') &&
      window.location.hostname !== 'localhost'
    ) {
      console.warn(
        'CRITICAL: Using a TEST Clerk key on a PRODUCTION domain. This will prevent hydration.',
      );
    }

    // Track the state machine for the login sequence
    let currentAttempt: any = null;
    let isResetMode = false;

    forgotPasswordBtn?.addEventListener('click', async () => {
      console.log('BIO_PUNK_UI: FORGOT_PHRASE_IMPULSE_RECEIVED');
      const identifier = identifierInput?.value;

      if (!identifier) {
        handleError('ERR: IDENTIFIER_REQUIRED_FOR_RESET');
        return;
      }

      errorDiv?.classList.add('hidden');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerText = 'PREPARING_RESET...';
      }

      try {
        let clerk = $clerkStore.get();
        if (!clerk || !clerk.client) {
          handleError('PROTOCOL_ERROR: Clerk Client Not Ready');
          return;
        }

        console.log('BIO_PUNK_UI: INITIATING_PASSWORD_RESET_HANDSHAKE...');
        currentAttempt = await clerk.client.signIn.create({
          identifier,
        });

        await currentAttempt.prepareFirstFactor({
          strategy: 'reset_password_email_code',
        });

        isResetMode = true;
        pivotToReset();
        handleNotice('RESET_PULSE_SENT_TO_SIGNAL_BUFFER');
      } catch (err: any) {
        console.error('BIO_PUNK_UI: RESET_INIT_ERROR', err);
        const message =
          err.errors?.[0]?.longMessage ||
          err.message ||
          'UNKNOWN_RESET_FAILURE';
        handleError(`ERR: ${message.toUpperCase()}`);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          if (isResetMode) {
            submitBtn.innerText = 'COMPLETE_RESET';
          } else {
            submitBtn.innerText = 'INITIALIZE_SESSION';
          }
        }
      }
    });

    loginForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      console.log('BIO_PUNK_UI: SUBMIT_IMPULSE_RECEIVED');

      // 1. INITIALIZE UI STATE
      errorDiv?.classList.add('hidden');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerText = 'PROCESSING_IMPULSE...';
      }

      // 2. TEMPORAL STABILIZATION (Wait for Clerk to hydrate)
      console.log('BIO_PUNK_UI: WAITING_FOR_CLERK_HYDRATION...');
      let clerk = $clerkStore.get();
      let retryCount = 0;
      while (!clerk && retryCount < 15) {
        console.log(`BIO_PUNK_UI: HYDRATION_RETRY_${retryCount}...`);
        await new Promise((resolve) => setTimeout(resolve, 200));
        clerk = $clerkStore.get();
        retryCount++;
      }

      if (!clerk || !clerk.client) {
        console.error('BIO_PUNK_UI: HYDRATION_FAILURE', {
          clerk: !!clerk,
          hasClient: !!clerk?.client,
        });
        handleError('PROTOCOL_ERROR: Clerk Client Not Ready');
        return;
      }

      console.log('BIO_PUNK_UI: CLERK_CLIENT_READY_PROCEEDING');

      // 3. EXTRACT INPUTS
      const formData = new FormData(loginForm);
      const identifier = formData.get('identifier') as string;
      const password = formData.get('password') as string;
      const code = formData.get('verification_code') as string;
      const resetCode = formData.get('reset_code') as string;
      const newPassword = formData.get('new_password') as string;

      console.log('BIO_PUNK_UI: DATA_EXTRACTED', {
        hasIdentifier: !!identifier,
        hasPassword: !!password,
        hasCode: !!code,
        isResetMode,
      });

      try {
        // PHASE RESET: PASSWORD RECONSTRUCTION
        if (isResetMode && resetCode && newPassword && currentAttempt) {
          console.log('BIO_PUNK_UI: ATTEMPTING_PASSWORD_RESET...');
          currentAttempt = await currentAttempt.attemptFirstFactor({
            strategy: 'reset_password_email_code',
            code: resetCode,
            password: newPassword,
          });
        }
        // PHASE A: INITIAL HANDSHAKE
        else if (!code && !currentAttempt) {
          console.log('BIO_PUNK_UI: STARTING_SIGN_IN_CREATE_HANDSHAKE...');
          currentAttempt = await clerk.client.signIn.create({
            identifier,
            password,
          });
          console.log('BIO_PUNK_UI: SIGN_IN_RESPONSE_RECEIVED', {
            status: currentAttempt?.status,
          });
        }
        // PHASE B: VERIFICATION SEQUENCE
        else if (code && currentAttempt) {
          console.log('BIO_PUNK_UI: STARTING_MFA_VERIFICATION...');
          currentAttempt = await currentAttempt.attemptFirstFactor({
            strategy: 'email_code',
            code,
          });
          console.log('BIO_PUNK_UI: MFA_RESPONSE_RECEIVED', {
            status: currentAttempt?.status,
          });
        }

        // 4. HANDLE OUTPUT STATES
        if (currentAttempt.status === 'complete') {
          console.log('BIO_PUNK_UI: SIGN_IN_COMPLETE_SETTING_ACTIVE...');
          await clerk.setActive({ session: currentAttempt.createdSessionId });

          // Metadata Fork: Determine landing zone
          const userRole = clerk.user?.publicMetadata?.role;
          const target = '/character';
          console.log('BIO_PUNK_UI: REDIRECT_TRIGGERED', { target, userRole });
          window.location.href = target;
        } else if (
          currentAttempt.status === 'needs_client_trust' ||
          currentAttempt.status === 'needs_first_factor'
        ) {
          console.log('BIO_PUNK_UI: PIVOTING_TO_CLIENT_TRUST_PROTOCOL', {
            status: currentAttempt.status,
          });

          // 1. Identify the Email Factor
          const emailFactor = currentAttempt.supportedFirstFactors.find(
            (f: any) => f.strategy === 'email_code',
          );

          if (!emailFactor) {
            throw new Error(
              'No secure email factor found for trust verification',
            );
          }

          // 2. Trigger the Email Send (Pulse Initialization)
          await currentAttempt.prepareFirstFactor({
            strategy: 'email_code',
            emailAddressId: emailFactor.emailAddressId,
          });

          // 3. UI STATE PIVOT
          pivotToVerification();
          handleNotice('VERIFICATION_PULSE_SENT_TO_SIGNAL_BUFFER');
        } else {
          console.warn('BIO_PUNK_UI: UNHANDLED_SIGN_IN_STATUS', {
            status: currentAttempt.status,
          });
        }
      } catch (err: any) {
        console.error('BIO_PUNK_UI: HANDSHAKE_ERROR', err);
        const message =
          err.errors?.[0]?.longMessage ||
          err.message ||
          'UNKNOWN_IMPULSE_FAILURE';

        if (message.toUpperCase().includes('ALREADY SIGNED IN')) {
          window.location.href = '/character';
          return;
        }

        handleError(`ERR: ${message.toUpperCase()}`);
        // If the attempt is corrupted (422), reset to allow a clean restart
        if (err.status === 422) currentAttempt = null;
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          // Check if we are in verification mode to update button text
          const isVerifying = !verificationSector?.classList.contains('hidden');
          const isResetting = !resetSector?.classList.contains('hidden');

          if (isResetting) {
            submitBtn.innerText = 'COMPLETE_RESET';
          } else if (isVerifying) {
            submitBtn.innerText = 'VERIFY_CODE';
          } else {
            submitBtn.innerText = 'INITIALIZE_SESSION';
          }
        }
      }
    });

    // UI HELPER: Switch to MFA input mode
    function pivotToVerification() {
      credentialsSector?.classList.add('hidden');
      verificationSector?.classList.remove('hidden');
      resetSector?.classList.add('hidden');

      // CRITICAL: Remove 'required' from hidden fields to prevent browser validation errors
      if (identifierInput) {
        identifierInput.required = false;
      }
      if (passwordInput) {
        passwordInput.required = false;
      }

      // Autofocus verification input
      const codeInput = document.getElementById(
        'verification_code',
      ) as HTMLInputElement;
      if (codeInput) {
        codeInput.required = true;
        codeInput.focus();
      }
    }

    // UI HELPER: Switch to Reset mode
    function pivotToReset() {
      credentialsSector?.classList.add('hidden');
      verificationSector?.classList.add('hidden');
      resetSector?.classList.remove('hidden');

      if (identifierInput) {
        identifierInput.required = false;
      }
      if (passwordInput) {
        passwordInput.required = false;
      }

      const resetCodeInput = document.getElementById(
        'reset_code',
      ) as HTMLInputElement;
      const newPasswordInput = document.getElementById(
        'new_password',
      ) as HTMLInputElement;

      if (resetCodeInput) {
        resetCodeInput.required = true;
        resetCodeInput.focus();
      }
      if (newPasswordInput) {
        newPasswordInput.required = true;
      }
    }

    // UI HELPER: Handle System Notices
    function handleNotice(msg: string) {
      if (errorDiv) {
        errorDiv.innerText = `NOTICE: ${msg}`;
        errorDiv.classList.remove('hidden');
        errorDiv.className =
          'border-l-2 border-primary bg-primary/10 p-2 font-display text-[10px] font-bold uppercase text-primary tracking-tight';
      }
    }

    // UI HELPER: Handle Protocol Errors
    function handleError(msg: string) {
      if (errorDiv) {
        errorDiv.innerText = msg;
        errorDiv.classList.remove('hidden');
        errorDiv.className =
          'border-l-2 border-red-600 bg-red-50 p-2 font-display text-[10px] font-bold uppercase text-red-600 tracking-tight';
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        const isVerifying = !verificationSector?.classList.contains('hidden');
        const isResetting = !resetSector?.classList.contains('hidden');

        if (isResetting) {
          submitBtn.innerText = 'RETRY_RESET';
        } else if (isVerifying) {
          submitBtn.innerText = 'RETRY_VERIFICATION';
        } else {
          submitBtn.innerText = 'REINITIALIZE_SESSION';
        }
      }
    }
  </script>
</Layout>
