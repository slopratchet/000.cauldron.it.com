---
import Layout from '../layouts/Layout.astro';
---

<Layout bodyClass="cimmerian-theme">
  <main
    class="flex-1 flex items-center justify-center p-8 min-h-screen relative overflow-hidden"
  >
    <div class="w-full max-w-md text-center">
      <div class="border-4 border-primary bg-paper p-8 relative z-10">
        <div
          class="absolute -top-4 left-4 bg-primary text-paper px-4 py-1 font-display text-xs font-bold tracking-widest uppercase"
        >
          TERMINATION_PROTOCOL
        </div>

        <div class="mb-10 mt-4">
          <h2
            class="font-display font-black text-3xl uppercase leading-none tracking-tighter mb-2 text-primary"
          >
            DE-INITIALIZING_SESSION
          </h2>
          <div class="h-1 w-12 bg-primary mx-auto"></div>
        </div>

        <div class="space-y-4">
          <p
            class="font-display text-[10px] font-bold uppercase tracking-widest opacity-60 text-primary animate-pulse"
          >
            PURGING_IDENTITY_BUFFER...
          </p>
          <div class="flex justify-center">
            <div
              class="w-8 h-8 border-4 border-primary border-t-transparent animate-spin"
            >
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script>
    import { $clerkStore } from '@clerk/astro/client';

    async function executeSignOut() {
      console.log('LOG_OUT: INITIALIZING_TERMINATION_PROTOCOL');

      // TEMPORAL STABILIZATION (Wait for Clerk to hydrate)
      let clerk = $clerkStore.get();
      let retryCount = 0;
      while (!clerk && retryCount < 50) {
        await new Promise((resolve) => setTimeout(resolve, 200));
        clerk = $clerkStore.get();
        retryCount++;
      }

      if (clerk) {
        try {
          console.log('LOG_OUT: EXECUTING_SIGN_OUT_COMMAND');
          await clerk.signOut();
          console.log('LOG_OUT: SIGN_OUT_COMPLETE');
        } catch (err) {
          console.error('LOG_OUT: SIGN_OUT_ERROR', err);
        }
      } else {
        console.warn('LOG_OUT: CLERK_CLIENT_NOT_FOUND_PROCEEDING_TO_LOGIN');
      }

      // Final redirect to entry point
      window.location.href = '/';
    }

    // Execute when ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', executeSignOut);
    } else {
      executeSignOut();
    }
  </script>
</Layout>
