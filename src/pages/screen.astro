---
import '../styles/global.css';
import ScreenApp from '../components/ScreenApp.tsx';

let status = 'OFFLINE';
try {
  const response = await fetch(new URL('/api/moon', Astro.url));
  if (response.ok) {
    const data = await response.json();
    status = data.status;
  }
} catch (e) {
  console.error('Failed to fetch system status:', e);
}

const isOnline = status === 'ONLINE';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Screen Page</title>
  </head><div class="font-label text-[10px] tracking-widest uppercase">
    CHRONOS SYSTEMS | PRINTED IN THE KINGDOM OF MANOR | STATUS: <span
      id="status-indicator"
      class={isOnline ? 'text-green-400' : 'text-red-400'}>{status}</span
    >
  </div>

  <body>
    <div class="screen-theme">
      <ScreenApp client:load />
    </div>
  </body>


</html>
