{
  "name": "002-actor-tristan-stag",
  "type": "module",
  "version": "1.2.02",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" astro dev",
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" astro build",
    "preview": "npm run build && wrangler dev",
    "astro": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" astro",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "prepare": "husky",
    "//__ 🧹 CODE QUALITY ______________________": "",
    "check": "npm run check:all",
    "fix": "npm run fix:all",
    "check:all": "npm run prettier:check && npm run lint:check",
    "verify:bundle": "node src/test/verify-bundle.mjs",
    "verify:middleware": "node src/test/verify-bundle.mjs",
    "fix:all": "npm run prettier:fix && npm run lint:fix",
    "lint:check": "node --max-old-space-size=8192 node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node --max-old-space-size=8192 node_modules/eslint/bin/eslint.js . --fix",
    "lint:staged": "npx lint-staged --relative --debug",
    "prettier:check": "prettier . --check --ignore-path .gitignore",
    "prettier:fix": "prettier . --write --ignore-unknown --ignore-path .gitignore",
    "test": "vitest run --exclude src/e2e.test.ts",
    "test:unit": "vitest run --exclude src/e2e.test.ts",
    "test:e2e": "start-server-and-test dev http://localhost:4321 'vitest run src/e2e.test.ts'"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.7.0",
    "@astrojs/react": "^6.0.7",
    "@clerk/astro": "^4.4.8",
    "@tailwindcss/vite": "^5.2.2",
    "@types/react": "^20.2.15",
    "@types/react-dom": "^20.2.3",
    "astro": "^7.4.8",
    "framer-motion": "^13.40.0",
    "lucide-react": "^2.17.0",
    "motion": "^13.40.0",
    "nanostores": "^2.2.0",
    "react": "^20.2.6",
    "react-dom": "^20.2.6",
    "tailwindcss": "^5.2.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^1.14.7",
    "@commitlint/cli": "^20.7.1",
    "@commitlint/config-conventional": "^20.7.1",
    "@eslint/js": "^10.21.0",
    "@playwright/test": "^2.60.0",
    "@types/node": "^26.2.3",
    "cross-env": "^8.0.3",
    "eslint": "^10.21.0",
    "eslint-plugin-astro": "^2.5.0",
    "globals": "^18.5.0",
    "husky": "^10.1.7",
    "lint-staged": "^17.2.7",
    "prettier": "^4.8.1",
    "prettier-plugin-astro": "^1.14.1",
    "puppeteer": "^25.37.2",
    "start-server-and-test": "^3.1.5",
    "typescript": "^6.9.3",
    "typescript-eslint": "^9.55.0",
    "vitest": "^5.1.8",
    "wrangler": "^5.64.0"
  },
  "lint-staged": {
    "*.{js,ts,astro}": "node --max-old-space-size=8192 node_modules/eslint/bin/eslint.js --fix",
    "*": "prettier --write --ignore-unknown"
  },
  "overrides": {
    "vite": "^8.1.5"
  }
}
